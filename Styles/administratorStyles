body{
     background-color: rgb(242, 239, 194);
     display: flex;
     justify-content: center;
     align-items: center;
     height: 100vh;
     font-family: Arial, sans-serif;
}

.mainForm{
   
    background-color: rgb(245, 243, 240);
    /*background: linear-gradient(to bottom, yellow, white 80%);*/
    padding: 50px;
    width: 1000px;
    text-align: center;
}

.container {
    /*display: flex;
    overflow-x: auto;
    scroll-behavior: smooth;
    gap: 25px;
    padding: 20px;
    */
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 20px;
}

.container::-webkit-scrollbar{
display: none;
}

.card:hover{
   transform: scale(1.05); 
   
} 

.profilePicture{
    border-radius: 100px;
}

@keyframes fadeEffect{
    from{opacity: 0;}
    to {opacity: 1;}
}

@media (max-width: 1280px){
    body{
        height: unset;
        padding: 30px;
    }

    .container{
        flex-wrap: wrap;
        justify-content: center;
    }

    .container .card{
        margin: 20px;
    }
}